<%# locals: (invoice:, reason: nil, reason_error: nil) -%>
<%# Shown only when the actor may decide now; the server re-checks everything on submit. %>
<% policy = InvoicePolicy.new(Current.user, invoice) %>
<% if policy.transition?("approve") || policy.transition?("reject") %>
  <section aria-labelledby="decision-heading" class="mt-8 max-w-2xl rounded-lg border border-slate-200 bg-white p-6"
    data-controller="decision-form"
    data-action="turbo:submit-start->decision-form#start turbo:submit-end->decision-form#end turbo:fetch-request-error->decision-form#end">
    <h2 id="decision-heading" class="text-lg font-semibold">Decision</h2>
    <p class="mt-1 text-sm text-slate-700">You are deciding on version <%= invoice.version %>. If someone else changes it first, nothing is applied and you'll see what changed.</p>

    <%# Each render gets a fresh idempotency key; resubmitting this same form reuses it, so a retry can't apply twice. %>
    <% if policy.transition?("approve") %>
      <%= form_with url: invoice_transitions_path(invoice), scope: :transition, class: "mt-4" do |form| %>
        <%= form.hidden_field :action, value: "approve", id: nil %>
        <%= form.hidden_field :expected_version, value: invoice.version, id: nil %>
        <%= form.hidden_field :idempotency_key, value: SecureRandom.uuid, id: nil %>
        <%= render "shared/button", label: "Approve", submits_with: "Approving…" %>
      <% end %>
    <% end %>

    <% if policy.transition?("reject") %>
      <%= form_with url: invoice_transitions_path(invoice), scope: :transition, class: "mt-6 border-t border-slate-200 pt-4" do |form| %>
        <%= form.hidden_field :action, value: "reject", id: nil %>
        <%= form.hidden_field :expected_version, value: invoice.version, id: nil %>
        <%= form.hidden_field :idempotency_key, value: SecureRandom.uuid, id: nil %>
        <%= render "shared/form_field", form:, attribute: :reason, label: "Reason for rejection (required)", input: :text_area,
              error: reason_error, value: reason, required: true, maxlength: TransitionInvoice::REASON_MAX, rows: 3 %>
        <%= render "shared/button", label: "Reject", variant: :danger, submits_with: "Rejecting…" %>
      <% end %>
    <% end %>

    <template data-decision-form-target="unknown">
      <div class="mb-6 rounded-md border border-pending-fg/40 bg-pending-bg px-4 py-3 text-sm font-medium text-pending-fg">
        <p>Outcome not confirmed: no response arrived, so your decision may or may not have been recorded. Retry is safe (it can't apply twice), or reload to see the current state.</p>
        <p class="mt-2 flex gap-3">
          <%= render "shared/button", label: "Retry", variant: :secondary, type: "button", data: { decision_form_retry: true } %>
          <%= link_to "Reload", invoice_path(invoice), class: "self-center font-semibold underline" %>
        </p>
      </div>
    </template>
  </section>
<% end %>
