<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= [ content_for(:title), "Workbench" ].compact.join(" · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Workbench">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-slate-100 text-slate-900 antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-10 focus:rounded-md focus:bg-white focus:px-4 focus:py-2 focus:font-semibold focus:text-brand">Skip to main content</a>

    <header class="border-b border-slate-200 bg-white">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-4 py-3">
        <p class="font-bold">
          <%= authenticated? ? link_to("Approval workbench", root_path, class: "text-brand-strong hover:underline") : "Approval workbench" %>
          <span class="ml-2 rounded bg-pending-bg px-1.5 py-0.5 text-xs font-semibold text-pending-fg">Demo · synthetic data</span>
        </p>
        <% if authenticated? %>
          <div class="flex flex-wrap items-center gap-4 text-sm">
            <p>Signed in as <strong><%= Current.user.name %></strong> (<%= Current.user.role %>) at <%= Current.company.name %></p>
            <%= form_with url: session_path, method: :delete do %>
              <%= render "shared/button", label: "Sign out", variant: :secondary, submits_with: "Signing out…" %>
            <% end %>
          </div>
        <% end %>
      </div>
    </header>

    <main id="main" tabindex="-1" class="mx-auto max-w-6xl px-4 py-8 focus:outline-none">
      <%= render "shared/notice", **flash_notice %>
      <%= yield %>
    </main>
  </body>
</html>
