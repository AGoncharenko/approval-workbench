<% content_for :title, "Not found" %>
<h1 class="text-2xl font-bold"><%= local_assigns[:heading] || "Invoice not available" %></h1>
<p class="mt-2 text-slate-700"><%= local_assigns[:message] || "This invoice doesn't exist, or it isn't visible to your account." %></p>
<p class="mt-4"><%= link_to "Back to the invoice list", invoices_path, class: "font-semibold text-brand underline hover:text-brand-strong" %></p>
