<% content_for :title, "Sign in" %>
<div class="mx-auto max-w-md">
  <h1 class="text-2xl font-bold">Sign in <small class="text-base font-normal text-slate-600">(demo)</small></h1>
  <p class="mt-1 mb-6 text-slate-700">Demo environment: all data is synthetic.</p>

  <%= form_with url: session_path, class: "rounded-lg border border-slate-200 bg-white p-6 shadow-sm" do |form| %>
    <%= render "shared/form_field", form:, attribute: :email_address, label: "Email address", input: :email_field,
          required: true, autofocus: true, autocomplete: "username", value: params[:email_address] %>
    <%= render "shared/form_field", form:, attribute: :password, label: "Password", input: :password_field,
          required: true, autocomplete: "current-password", maxlength: 72 %>
    <%= render "shared/button", label: "Sign in", submits_with: "Signing in…" %>
  <% end %>

  <% if @demo_accounts %>
    <section aria-labelledby="demo-accounts" class="mt-8">
      <h2 id="demo-accounts" class="text-lg font-semibold">Demo accounts</h2>
      <p class="text-sm text-slate-700">Every account uses the demo password from the README.</p>
      <ul class="mt-2 space-y-1 text-sm">
        <% @demo_accounts.each do |user| %>
          <li><span class="font-mono"><%= user.email_address %></span> &mdash; <%= user.role %>, <%= user.company.name %></li>
        <% end %>
      </ul>
    </section>
  <% end %>
</div>
